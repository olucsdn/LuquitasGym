# Configurações do Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Trava de Acesso Inicial (Feature Flag)
# false = oculta cadastro público, permitindo apenas login do criador
# true = libera onboarding e cadastro para novos usuários
VITE_ALLOW_PUBLIC_SIGNUP=false
